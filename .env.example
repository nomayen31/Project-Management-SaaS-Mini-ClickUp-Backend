PORT=4000
# Neon pooled connection for the API.
DATABASE_URL=
# Neon direct connection for Prisma migration commands.
DIRECT_URL=

# Public origin serving /api/auth through Next.js.
APP_ORIGIN=http://localhost:3000
# Use a randomly generated secret with at least 32 characters.
BETTER_AUTH_SECRET=
# Configure both settings in each provider pair below.
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_API_KEY=
AUTH_SENTINEL=false

# Optional private task attachment storage. Configure all three values.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
